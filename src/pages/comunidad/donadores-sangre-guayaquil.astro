---
import InternalPage from "@components/InternalPage.astro";
import { SITE_CONTENT } from "@config";
import Layout from "@layouts/Layout.astro";

const initiative = SITE_CONTENT.community.items.find(
  ({ name }) => name === "Donadores de sangre en Guayaquil",
);
---

<Layout>
  <InternalPage
    title="Donadores de sangre en Guayaquil"
    note="Página de iniciativa en preparación."
  >
    <p>{initiative?.summary}</p>
  </InternalPage>
</Layout>
