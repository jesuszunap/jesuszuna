---
import { SITE_CONTENT } from "@config";
import Hero from "@components/Hero.astro";
import Layout from "@layouts/Layout.astro";
import SoftwareProjects from "@components/SoftwareProjects.astro";
import About from "@components/About.astro";
import CommunityImpact from "@components/CommunityImpact.astro";
import Contact from "@components/Contact.astro";

import "../styles/global.css";
---

<Layout>
  <Hero {...SITE_CONTENT.hero} />
  <About {...SITE_CONTENT.about} name={SITE_CONTENT.hero.name} />
  <SoftwareProjects projects={SITE_CONTENT.projects} />
  <CommunityImpact />
  <Contact />
</Layout>
