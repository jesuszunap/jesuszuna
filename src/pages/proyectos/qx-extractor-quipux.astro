---
import InternalPage from "@components/InternalPage.astro";
import { SITE_CONTENT } from "@config";
import Layout from "@layouts/Layout.astro";

const project = SITE_CONTENT.projects.items.find(
  ({ name }) => name === "QX - Extractor Quipux",
);
---

<Layout>
  <InternalPage
    title="QX - Extractor Quipux"
    badge="Proyecto destacado"
    note="Página de proyecto en preparación."
  >
    <p>{project?.summary}</p>
  </InternalPage>
</Layout>
