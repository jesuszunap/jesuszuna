---
import Layout from "@layouts/Layout.astro";

const title = "Cotizador WH | Proyecto de Jesús Zuña";
const description =
  "Cotizador WH es una webapp/PWA ligera para calcular cotizaciones, comisiones y montos finales de forma rápida desde el celular, con integración para WhatsApp.";

const assetPath = "/images/projects/cotizador-wh";
const appUrl = "https://cotizador.jesuszuna.com";
const exampleUrl = "https://cotizador.jesuszuna.com/?monto=20";

const tags = ["Web", "PWA", "JavaScript", "Responsive", "Offline", "WhatsApp"];

const features = [
  "Cálculo de comisión",
  "Monto final a transferir",
  "Efectivo Móvil cuando aplica",
  "Copiar resultado",
  "Compartir por WhatsApp",
  "Historial local",
  "Modo claro/oscuro",
  "Funcionamiento offline como PWA",
  "Enlaces con monto prellenado",
];

const technologies = [
  "React",
  "Vite",
  "JavaScript",
  "PWA",
  "localStorage",
  "GitHub Pages",
  "Dominio propio",
];

const comparisons = [
  {
    title: "Ingreso del monto",
    description:
      "Antes, ingresar la cantidad dependía de una interfaz más pesada. Ahora el flujo se centra en el monto y la cantidad de envíos, con controles grandes y pensados para celular.",
    before: {
      src: "appsheet-1.webp",
      alt: "Pantalla anterior en AppSheet para ingresar el monto de la cotización.",
    },
    after: {
      light: "wh-1-light.webp",
      dark: "wh-1-dark.webp",
      alt: "Pantalla actual de Cotizador WH para ingresar monto y cantidad de envíos.",
    },
  },
  {
    title: "Resultado de la cotización",
    description:
      "El resultado actual prioriza la lectura rápida: comisión, monto final, efectivo móvil cuando aplica y acciones para copiar o compartir.",
    before: {
      src: "appsheet-2.webp",
      alt: "Resultado anterior de cotización mostrado en AppSheet.",
    },
    after: {
      light: "wh-2-light.webp",
      dark: "wh-2-dark.webp",
      alt: "Resultado actual de cotización mostrado en Cotizador WH.",
    },
  },
];
---

<Layout
  title={title}
  description={description}
  ogTitle="Cotizador WH"
  ogDescription={description}
  ogImage={`${assetPath}/cover-light.webp`}
>
  <article class="pt-8 pb-14 md:pt-12 md:pb-20">
    <a class="mb-8 inline-block text-sm font-medium text-primary" href="/#proyectos">
      Volver a proyectos
    </a>

    <section class="grid items-center gap-8 lg:grid-cols-[0.95fr_1.05fr]">
      <div>
        <span class="hero-badge mb-5 inline-block rounded-full px-3 py-1 text-xs font-medium">
          Webapp / PWA ligera
        </span>
        <h1 class="font-serif text-4xl font-bold text-white md:text-6xl">
          Cotizador WH
        </h1>
        <p class="mt-6 text-lg text-neutral">
          Una herramienta web para calcular cotizaciones de forma rápida, clara y
          cómoda desde el celular, reemplazando un flujo previo basado en
          AppSheet por una experiencia más ligera y directa.
        </p>
        <ul class="mt-7 flex flex-wrap gap-2">
          {
            tags.map((tag) => (
              <li class="rounded-full border border-border bg-soft px-3 py-1 text-xs text-neutral">
                {tag}
              </li>
            ))
          }
        </ul>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn-primary" href={appUrl}>
            Abrir Cotizador WH
          </a>
          <a class="btn-secondary" href="#antes-despues">
            Ver comparación
          </a>
        </div>
      </div>

      <figure class="media-card hero-cover overflow-hidden rounded-lg border border-border bg-card shadow-sm">
        <img
          class="block w-full dark:hidden"
          src={`${assetPath}/cover-light.webp`}
          alt="Banner visual de Cotizador WH con mockup móvil y valores de cotización en modo claro."
          width="1600"
          height="900"
          fetchpriority="high"
        />
        <img
          class="hidden w-full dark:block"
          src={`${assetPath}/cover-dark.webp`}
          alt="Banner visual de Cotizador WH con mockup móvil y valores de cotización en modo oscuro."
          width="1600"
          height="900"
          fetchpriority="high"
        />
      </figure>
    </section>

    <section class="project-section project-section-first grid gap-5 md:grid-cols-2">
      <div class="project-card">
        <h2>De una calculadora lenta a una experiencia más rápida</h2>
        <p>
          Antes, el cálculo dependía de una solución en AppSheet conectada a una
          hoja de cálculo. Para un uso frecuente desde celular, especialmente en
          conversaciones por WhatsApp, ese flujo podía sentirse lento o incómodo.
        </p>
      </div>
      <div class="project-card">
        <h2>Cotizar directamente desde el navegador</h2>
        <p>
          Cotizador WH calcula en el navegador, muestra solo lo necesario y
          permite cotizar, copiar o compartir el resultado con mayor rapidez. La
          herramienta busca resolver una tarea concreta sin convertirla en un
          proceso más pesado.
        </p>
      </div>
    </section>

    <section class="project-section scroll-mt-24" id="antes-despues">
      <div class="section-heading">
        <h2>Antes y después</h2>
        <p>
          La mejora principal está en hacer más directo el flujo para cotizar
          desde el celular y responder a clientes con mayor rapidez.
        </p>
      </div>

      <div class="grid gap-6">
        {
          comparisons.map((comparison) => (
            <section class="comparison-block no-lift rounded-lg border border-border bg-card p-5 shadow-sm backdrop-blur-md md:p-6">
              <div class="mb-5">
                <h3 class="font-serif text-2xl font-semibold text-white">
                  {comparison.title}
                </h3>
                <p class="mt-3 text-sm text-neutral">{comparison.description}</p>
              </div>

              <div class="grid gap-4 lg:grid-cols-2">
                <figure class="comparison-card">
                  <figcaption>Antes · AppSheet</figcaption>
                  <div class="comparison-image">
                    <img
                      src={`${assetPath}/${comparison.before.src}`}
                      alt={comparison.before.alt}
                      loading="lazy"
                    />
                  </div>
                </figure>

                <figure class="comparison-card">
                  <figcaption>Después · Cotizador WH</figcaption>
                  <div class="comparison-image">
                    <img
                      class="block dark:hidden"
                      src={`${assetPath}/${comparison.after.light}`}
                      alt={`${comparison.after.alt} Modo claro.`}
                      loading="lazy"
                    />
                    <img
                      class="hidden dark:block"
                      src={`${assetPath}/${comparison.after.dark}`}
                      alt={`${comparison.after.alt} Modo oscuro.`}
                      loading="lazy"
                    />
                  </div>
                </figure>
              </div>
            </section>
          ))
        }
      </div>
    </section>

    <section class="project-section">
      <div class="section-heading">
        <h2>Funciones principales</h2>
        <p>
          Funciones pequeñas y concretas para resolver una cotización de forma
          rápida, clara y cómoda desde cualquier dispositivo.
        </p>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          features.map((feature) => (
            <article class="project-card feature-card">
              <h3>{feature}</h3>
            </article>
          ))
        }
      </div>
    </section>

    <section class="project-section grid gap-5 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="project-card">
        <h2>Integración con WhatsApp</h2>
        <p>
          La app puede abrirse con un monto prellenado mediante URL. Esto permite
          integrarla con respuestas rápidas o autoresponder para que el cliente
          abra directamente la cotización.
        </p>
      </div>
      <div class="project-card">
        <p class="text-xs font-medium text-primary">Ejemplo</p>
        <a class="code-link mt-4 block break-all" href={exampleUrl}>
          {exampleUrl}
        </a>
        <p class="mt-5 text-sm text-neutral">
          Al entrar desde ese enlace, Cotizador WH puede iniciar con el monto ya
          cargado y listo para revisar el resultado.
        </p>
      </div>
    </section>

    <section class="project-section grid gap-5 lg:grid-cols-2">
      <div class="project-card">
        <h2>Tecnologías utilizadas</h2>
        <p>
          Cotizador WH usa tecnologías web ligeras para priorizar velocidad,
          instalación como PWA y persistencia local sin depender de una
          infraestructura compleja.
        </p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {
            technologies.map((technology) => (
              <li class="rounded-full border border-border bg-soft px-3 py-1 text-xs text-neutral">
                {technology}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="project-card cta-card">
        <h2>Una herramienta pequeña, pero pensada para uso real</h2>
        <p>
          El valor del proyecto está en resolver una tarea repetitiva de forma
          rápida y clara: cotizar desde cualquier dispositivo, reducir espera y
          facilitar respuestas a clientes.
        </p>
        <a class="btn-primary mt-7" href={appUrl}>
          Abrir Cotizador WH
        </a>
      </div>
    </section>
  </article>
</Layout>

<style>
  .project-section {
    margin-top: 5rem;
  }

  .project-section-first {
    margin-top: 3.5rem;
  }

  .section-heading {
    max-width: 48rem;
    margin-bottom: 2.5rem;
  }

  .section-heading h2,
  .project-card h2 {
    font-family: var(--font-sora);
    font-size: 2rem;
    font-weight: 700;
    line-height: 2.45rem;
    color: var(--text-main);
  }

  .section-heading p,
  .project-card p {
    margin-top: 1rem;
    color: var(--text-muted);
  }

  .project-card,
  .comparison-block,
  .comparison-card,
  .media-card {
    border: 1px solid var(--border-soft);
    border-radius: 0.5rem;
    background: var(--surface-card);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.1);
    backdrop-filter: blur(12px);
  }

  .project-card {
    padding: 1.5rem;
  }

  .project-card h3 {
    font-family: var(--font-sora);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.55rem;
    color: var(--text-main);
  }

  .feature-card {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 7rem;
    text-align: center;
  }

  .feature-card h3 {
    max-width: 13rem;
    line-height: 1.25;
    text-align: center;
  }

  .hero-badge {
    background: var(--accent-main);
    color: var(--surface-page);
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .btn-primary {
    background: var(--accent-main);
    color: var(--surface-page);
  }

  .btn-secondary {
    border: 1px solid var(--border-soft);
    background: var(--surface-card-strong);
    color: var(--text-main);
  }

  .comparison-block {
    padding: 1.25rem;
  }

  .comparison-card {
    overflow: hidden;
    background: var(--surface-card-strong);
  }

  .comparison-card figcaption {
    border-bottom: 1px solid var(--border-soft);
    padding: 0.75rem 0.9rem;
    color: var(--accent-main);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .comparison-image {
    display: grid;
    min-height: 20rem;
    place-items: center;
    background: var(--surface-soft);
    padding: 0.65rem;
  }

  .comparison-image img {
    max-height: 40rem;
    width: 100%;
    object-fit: contain;
    border-radius: 0.5rem;
    box-shadow: 0 12px 28px rgb(0 0 0 / 0.12);
  }

  .code-link {
    border: 1px solid var(--border-soft);
    border-radius: 0.5rem;
    background: var(--surface-soft);
    padding: 1rem;
    color: var(--text-main);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .cta-card {
    background:
      linear-gradient(180deg, var(--surface-card-strong), var(--surface-card)),
      var(--surface-card);
  }

  .project-card,
  .comparison-block,
  .comparison-card,
  .btn-primary,
  .btn-secondary,
  .code-link,
  li.rounded-full {
    transition:
      transform 220ms ease,
      box-shadow 220ms ease,
      border-color 220ms ease,
      background-color 220ms ease,
      color 220ms ease;
  }

  @media (hover: hover) {
    .project-card:hover,
    .comparison-block:hover,
    .comparison-card:hover {
      border-color: var(--accent-main);
      box-shadow: 0 12px 28px rgb(0 0 0 / 0.1);
      transform: translateY(-2px);
    }

    .no-lift:hover {
      transform: none;
    }

    .media-card:hover,
    .hero-cover:hover {
      border-color: var(--border-soft);
      box-shadow: 0 1px 3px rgb(0 0 0 / 0.1);
      transform: none;
    }

    .btn-primary:hover,
    .btn-secondary:hover,
    .code-link:hover {
      border-color: var(--accent-main);
      box-shadow: 0 10px 22px rgb(0 0 0 / 0.1);
      transform: translateY(-2px);
    }

    li.rounded-full:hover {
      border-color: var(--accent-main);
      background-color: var(--surface-card-strong);
      transform: translateY(-1px);
    }
  }

  @media (min-width: 768px) {
    .project-section-first {
      margin-top: 4rem;
    }
  }

  @media (min-width: 48rem) {
    .project-card {
      padding: 2rem;
    }

    .comparison-block {
      padding: 1.5rem;
    }

    .comparison-image {
      min-height: 24rem;
      padding: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .comparison-block,
    .comparison-card,
    .btn-primary,
    .btn-secondary,
    .code-link,
    li.rounded-full {
      transition: none;
    }

    .project-card:hover,
    .comparison-block:hover,
    .comparison-card:hover,
    .btn-primary:hover,
    .btn-secondary:hover,
    .code-link:hover,
    li.rounded-full:hover {
      transform: none;
    }
  }
</style>
