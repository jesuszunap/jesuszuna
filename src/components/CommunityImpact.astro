---
import Section from "./Section.astro";
import type { CommunitySectionProps } from "@types";

type Props = CommunitySectionProps;

const { id, title, subtitle, items } = Astro.props;
---

<Section text={title} href={id}>
  <p class="mb-10 max-w-3xl text-base text-neutral">{subtitle}</p>
  <div class="grid items-stretch gap-5 md:grid-cols-2 lg:grid-cols-3">
    {
      items.map(({ name, status, summary, cardSummary, impact, shortImpact, action }) => (
        <article class="flex h-full flex-col rounded-lg border border-border bg-card p-6 shadow-sm backdrop-blur-md md:min-h-[28rem]">
          <div class="mb-4 min-h-14">
            <h3 class="font-serif text-2xl font-semibold text-white">
              {name}
            </h3>
            {status && <span class="mt-2 block text-xs text-primary">{status}</span>}
          </div>
          <p class="mb-5 text-sm text-neutral">{cardSummary ?? summary}</p>
          {(shortImpact ?? impact) && (
            <p class="mt-auto border-t border-border pt-5 text-sm text-white/80">
              <span class="font-medium text-white">Impacto: </span>
              {shortImpact ?? impact}
            </p>
          )}
          {action && (
            <a
              href={action.href}
              class="mt-7 inline-block text-sm font-medium text-white hover:text-primary"
            >
              {action.text}
            </a>
          )}
        </article>
      ))
    }
  </div>
</Section>
