---
interface Props {
  title: string;
  badge?: string;
  note?: string;
}

const { title, badge, note = "Contenido en preparación." } = Astro.props;
---

<section class="py-20 md:py-28">
  <a class="mb-10 inline-block text-sm font-medium text-primary" href="/">
    Volver al inicio
  </a>
  <article
    class="max-w-3xl rounded-lg border border-border bg-card p-6 shadow-sm backdrop-blur-md md:p-8"
  >
    {
      badge && (
        <span class="mb-5 inline-block rounded-full bg-primary px-3 py-1 text-xs font-medium text-black">
          {badge}
        </span>
      )
    }
    <h1 class="font-serif text-4xl font-bold text-white md:text-5xl">
      {title}
    </h1>
    <div class="mt-8 space-y-5 text-base text-neutral">
      <slot />
    </div>
    <p class="mt-8 border-t border-border pt-5 text-sm text-primary">
      {note}
    </p>
  </article>
</section>
