---
import Section from "./Section.astro";
import type { ProjectsSectionProps } from "@types";

type Props = ProjectsSectionProps;

const { id, title, subtitle, items } = Astro.props;
---

<Section text={title} href={id}>
  <p class="mb-10 text-base text-neutral">{subtitle}</p>
  {
    items.map(
      (
        { name, badge, status, summary, problem, technologies, action },
        index,
      ) => {
        const top = 98 + index * 40;
        return (
          <div
            style={`top: ${top}px;`}
            class="sticky mb-12 rounded-2xl border border-neutral/20 bg-black"
          >
            <article class="relative z-1 rounded-2xl bg-[#1c232d]/85 p-6 before:absolute before:inset-0 before:z-[-1] before:rounded-2xl before:bg-[url(/raja.png)] before:bg-size-[128px] before:bg-repeat before:opacity-5 before:content-[''] md:p-8">
              <div class="mb-5 flex flex-wrap gap-3">
                {badge && (
                  <span class="rounded-full bg-primary px-3 py-1 text-xs font-medium text-white">
                    {badge}
                  </span>
                )}
                <span class="text-xs text-neutral">{status}</span>
              </div>
              <h3 class="mb-5 font-serif text-3xl font-medium text-primary">
                {name}
              </h3>
              <p class="mb-5 text-base text-neutral">{summary}</p>
              {problem && (
                <p class="mb-6 text-sm text-white/80">
                  <span class="text-white">Problema que resuelve: </span>
                  {problem}
                </p>
              )}
              {technologies.length > 0 && (
                <ul class="mb-8 flex flex-wrap gap-2 text-xs text-neutral">
                  {technologies.map((technology) => (
                    <li class="rounded-full border border-neutral/20 px-3 py-1">
                      {technology}
                    </li>
                  ))}
                </ul>
              )}
              {action && (
                <a
                  href={action.href}
                  class="inline-block text-sm font-medium text-white hover:text-primary"
                >
                  {action.text}
                </a>
              )}
            </article>
          </div>
        );
      },
    )
  }
</Section>
