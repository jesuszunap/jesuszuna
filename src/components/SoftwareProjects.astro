---
import Section from "./Section.astro";
import type { ProjectsSectionProps } from "@types";

type Props = ProjectsSectionProps;

const { id, title, subtitle, items } = Astro.props;
---

<Section text={title} href={id}>
  <p class="mb-10 max-w-3xl text-base text-neutral">{subtitle}</p>
  <div class="grid items-stretch gap-5 md:grid-cols-2 lg:grid-cols-3">
    {
      items.map(({ name, badge, status, summary, cardSummary, technologies, action }) => (
        <article class="flex h-full flex-col rounded-lg border border-border bg-card p-6 shadow-sm backdrop-blur-md motion-safe:transition motion-safe:duration-300 motion-safe:ease-out hover:border-primary hover:shadow-xl motion-safe:hover:-translate-y-1 md:min-h-[27rem]">
          <div class="mb-5 flex min-h-8 flex-wrap items-center gap-3">
            {badge && (
              <span class="rounded-full bg-primary px-3 py-1 text-xs font-medium text-black motion-safe:transition motion-safe:duration-200 motion-safe:hover:-translate-y-0.5">
                {badge}
              </span>
            )}
            <span class="text-xs text-neutral">{status}</span>
          </div>
          <h3 class="mb-4 font-serif text-2xl font-semibold text-white">
            {action ? (
              <a
                href={action.href}
                class="rounded-sm transition-colors hover:text-primary focus-visible:text-primary motion-safe:hover:translate-x-0.5"
                aria-label={`Ver proyecto ${name}`}
              >
                {name}
              </a>
            ) : (
              name
            )}
          </h3>
          <p class="mb-6 text-sm text-neutral">{cardSummary ?? summary}</p>
          {technologies.length > 0 && (
            <ul class="mt-auto flex flex-wrap gap-2 pt-2 text-xs text-neutral">
              {technologies.map((technology) => (
                <li class="rounded-full border border-border bg-soft px-3 py-1 motion-safe:transition motion-safe:duration-200 hover:border-primary hover:bg-card-strong motion-safe:hover:-translate-y-0.5">
                  {technology}
                </li>
              ))}
            </ul>
          )}
          {action && (
            <a
              href={action.href}
              class="mt-7 inline-block text-sm font-medium text-white motion-safe:transition motion-safe:duration-200 hover:text-primary motion-safe:hover:translate-x-1"
            >
              {action.text}
            </a>
          )}
        </article>
      ))
    }
  </div>
</Section>
