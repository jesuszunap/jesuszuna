---
import Section from "./Section.astro";
import type { ContactProps } from "@types";

type Props = ContactProps;

const { id, title, text, form, channels } = Astro.props;
---

<Section text={title} href={id}>
  <div class="grid gap-8 md:grid-cols-[1fr_0.8fr]">
    <div class="rounded-lg border border-border bg-card p-6 shadow-sm backdrop-blur-md md:p-8">
      <p class="mb-8 text-base text-neutral">{text}</p>
      <form class="space-y-4">
        <input
          class="w-full rounded-lg border border-border bg-card-strong px-4 py-3 text-sm text-white outline-none placeholder:text-neutral focus:border-primary"
          type="text"
          placeholder={form.name}
        />
        <input
          class="w-full rounded-lg border border-border bg-card-strong px-4 py-3 text-sm text-white outline-none placeholder:text-neutral focus:border-primary"
          type="email"
          placeholder={form.email}
        />
        <input
          class="w-full rounded-lg border border-border bg-card-strong px-4 py-3 text-sm text-white outline-none placeholder:text-neutral focus:border-primary"
          type="text"
          placeholder={form.subject}
        />
        <textarea
          class="min-h-36 w-full rounded-lg border border-border bg-card-strong px-4 py-3 text-sm text-white outline-none placeholder:text-neutral focus:border-primary"
          placeholder={form.message}></textarea>
        <button
          class="rounded-full bg-primary px-8 py-4 text-sm font-medium text-black hover:-translate-y-0.5"
          type="button"
        >
          {form.button}
        </button>
      </form>
    </div>
    <ul class="space-y-4">
      {
        channels.map(({ text, value, href }) => (
          <li class="rounded-lg border border-border bg-card p-5 shadow-sm backdrop-blur-md">
            <p class="text-xs font-medium text-primary">{text}</p>
            {href ? (
              <a
                class="mt-2 inline-block text-sm text-white hover:text-primary"
                href={href}
                target={href.startsWith("http") ? "_blank" : undefined}
              >
                {value}
              </a>
            ) : (
              <p class="mt-2 text-sm text-white">{value}</p>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</Section>
