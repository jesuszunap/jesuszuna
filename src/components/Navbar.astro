---
import Menu from "@icons/Menu.astro";
import type { NavbarProps } from "@types";

type Props = NavbarProps;

const { brand, navLinks } = Astro.props;
const isHome = Astro.url.pathname === "/";
const getNavHref = (href: string) =>
  href.startsWith("#") && !isHome ? `/${href}` : href;
---

<header
  class="sticky top-0 z-50 mx-auto mt-3 flex max-w-5xl animate-slide-in items-center justify-between rounded-lg border border-border bg-card px-4 py-3 shadow-sm backdrop-blur-md md:px-5"
>
  <a
    href={getNavHref("#inicio")}
    aria-label="Ir al inicio"
    class="font-serif text-lg font-bold text-white md:text-xl"
  >
    {brand}
  </a>

  <div class="flex items-center gap-2 lg:gap-3">
    <nav
      class="absolute top-18 right-5 z-60 hidden rounded-lg border border-border bg-[#fbf9ff]/96 px-4 py-5 text-neutral shadow-2xl ring-1 ring-black/5 backdrop-blur-xl lg:static lg:block lg:border-0 lg:bg-transparent lg:p-0 lg:shadow-none lg:ring-0 lg:backdrop-blur-0 dark:bg-[#08121c]/96 lg:dark:bg-transparent"
      id="main-menu"
    >
      <ul class="gap-2 lg:flex">
        {
          navLinks.map((link) => (
            <li class="relative">
              <a
                class={`nav-item relative block p-2 text-sm font-medium transition-all duration-500 after:absolute after:bottom-0 after:left-2/4 after:h-1 after:w-1 after:-translate-x-2/4 after:rounded-full after:bg-primary after:opacity-0 after:content-[''] hover:text-white`}
                href={getNavHref(link.href)}
                data-nav-href={link.href}
              >
                {link.text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      type="button"
      id="theme-button"
      class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border bg-card-strong text-neutral shadow-sm backdrop-blur-md hover:border-primary hover:text-primary"
      aria-label="Cambiar a modo oscuro"
      title="Cambiar a modo oscuro"
    >
      <svg
        data-theme-icon="dark"
        aria-hidden="true"
        class="h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M20.4 14.7A8.5 8.5 0 0 1 9.3 3.6 8.5 8.5 0 1 0 20.4 14.7Z"></path>
      </svg>
      <svg
        data-theme-icon="light"
        aria-hidden="true"
        class="hidden h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2"></path>
        <path d="M12 20v2"></path>
        <path d="m4.9 4.9 1.4 1.4"></path>
        <path d="m17.7 17.7 1.4 1.4"></path>
        <path d="M2 12h2"></path>
        <path d="M20 12h2"></path>
        <path d="m6.3 17.7-1.4 1.4"></path>
        <path d="m19.1 4.9-1.4 1.4"></path>
      </svg>
    </button>

    <button
      type="button"
      id="menu-button"
      class="px-1.5 text-neutral hover:text-primary lg:hidden"
      aria-expanded="false"
      aria-controls="main-menu"
      aria-label="Abrir menú de navegación"
    >
      <Menu />
    </button>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>("#menu-button");
  const themeButton =
    document.querySelector<HTMLButtonElement>("#theme-button");
  const lightIcon = document.querySelector<SVGElement>(
    '[data-theme-icon="light"]',
  );
  const darkIcon = document.querySelector<SVGElement>(
    '[data-theme-icon="dark"]',
  );
  const menu = document.querySelector("#main-menu");
  const navItems = document.querySelectorAll("#main-menu > ul > li > a");
  const sections = [
    ...document.querySelectorAll<HTMLElement>("section[id]"),
  ];
  const themeStorageKey = "theme";
  let lockedSectionId: string | null = null;
  let unlockTimer: number | undefined;

  const getPreferredTheme = () => {
    const savedTheme = localStorage.getItem(themeStorageKey);
    if (savedTheme === "light" || savedTheme === "dark") {
      return savedTheme;
    }

    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  };

  const updateThemeButton = (theme: string) => {
    const isDark = theme === "dark";
    themeButton?.setAttribute(
      "aria-label",
      isDark ? "Cambiar a modo claro" : "Cambiar a modo oscuro",
    );
    themeButton?.setAttribute(
      "title",
      isDark ? "Cambiar a modo claro" : "Cambiar a modo oscuro",
    );
    lightIcon?.classList.toggle("hidden", !isDark);
    darkIcon?.classList.toggle("hidden", isDark);
  };

  const applyTheme = (theme: string, shouldPersist = false) => {
    document.documentElement.classList.remove("light", "dark");
    document.documentElement.classList.add(theme);
    document.documentElement.style.colorScheme = theme;

    if (shouldPersist) {
      localStorage.setItem(themeStorageKey, theme);
    }

    updateThemeButton(theme);
  };

  const setActiveNavItem = (sectionId: string) => {
    navItems.forEach((item) => {
      const itemSectionId = getItemSectionId(item);
      if (itemSectionId === sectionId) {
        item.classList.add("text-white", "lg:after:opacity-100");
      } else {
        item.classList.remove("text-white", "lg:after:opacity-100");
      }
    });
  };

  const getItemSectionId = (item: Element) => {
    const href = item.getAttribute("href");

    if (!href) {
      return null;
    }

    if (href === "/" || href === "#inicio" || href === "/#inicio") {
      return "inicio";
    }

    if (href.startsWith("#")) {
      return href.slice(1);
    }

    if (href.startsWith("/#")) {
      return href.slice(2);
    }

    return null;
  };

  const updateActiveNavItem = () => {
    if (lockedSectionId) {
      setActiveNavItem(lockedSectionId);
      return;
    }

    const headerOffset = 140;
    const currentPosition = window.scrollY + headerOffset;
    const currentSection = sections
      .filter((section) => currentPosition >= section.offsetTop)
      .at(-1);

    if (currentSection) {
      setActiveNavItem(currentSection.id);
    }
  };

  const toggleMenu = () => {
    menu?.classList.toggle("hidden");
    const isHidden = menu?.classList.contains("hidden");
    button?.setAttribute("aria-expanded", `${!isHidden}`);
    button?.setAttribute(
      "aria-label",
      isHidden ? "Abrir menú de navegación" : "Cerrar menú de navegación",
    );
  };

  themeButton?.addEventListener("click", () => {
    const nextTheme = document.documentElement.classList.contains("dark")
      ? "light"
      : "dark";

    applyTheme(nextTheme, true);
  });

  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", () => {
      if (!localStorage.getItem(themeStorageKey)) {
        applyTheme(getPreferredTheme());
      }
    });

  button?.addEventListener("click", toggleMenu);
  navItems.forEach((item) => {
    item?.addEventListener("click", () => {
      const sectionId = getItemSectionId(item);
      if (sectionId) {
        lockedSectionId = sectionId;
        setActiveNavItem(sectionId);

        window.clearTimeout(unlockTimer);
        unlockTimer = window.setTimeout(() => {
          lockedSectionId = null;
          updateActiveNavItem();
        }, 900);
      }

      if (!menu?.classList.contains("hidden")) {
        toggleMenu();
      }
    });
  });

  window.addEventListener("scroll", updateActiveNavItem, { passive: true });
  window.addEventListener("load", updateActiveNavItem);
  window.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !menu?.classList.contains("hidden")) {
      toggleMenu();
      button?.focus();
    }
  });
  applyTheme(getPreferredTheme());
  updateActiveNavItem();
</script>
