---
import Menu from "@icons/Menu.astro";
import type { NavbarProps } from "@types";

type Props = NavbarProps;

const { brand, navLinks } = Astro.props;
---

<header
  class="sticky top-0 z-50 mx-auto mt-3 flex max-w-5xl animate-slide-in items-center justify-between rounded-lg border border-border bg-card px-4 py-3 shadow-sm backdrop-blur-md md:px-5"
>
  <a
    href="#inicio"
    aria-label="Ir al inicio"
    class="font-serif text-lg font-bold text-white md:text-xl"
  >
    {brand}
  </a>

  <button
    type="button"
    id="menu-button"
    class="px-1.5 text-neutral hover:text-primary lg:hidden"
    aria-expanded="false"
    aria-controls="main-menu"
  >
    <Menu />
  </button>

  <nav
    class="absolute top-18 right-5 hidden rounded-lg border border-border bg-card-strong px-4 py-5 text-neutral shadow-sm backdrop-blur-md lg:static lg:block lg:border-0 lg:bg-transparent lg:p-0 lg:shadow-none lg:backdrop-blur-0"
    id="main-menu"
  >
    <ul class="gap-2 lg:flex">
      {
        navLinks.map((link) => (
          <li class="relative">
            <a
              class={`nav-item relative block p-2 text-sm font-medium transition-all duration-500 after:absolute after:bottom-0 after:left-2/4 after:h-2 after:w-1 after:-translate-x-2/4 after:text-primary after:opacity-0 after:content-['•'] hover:text-white`}
              href={link.href}
            >
              {link.text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const button = document.querySelector("#menu-button");
  const menu = document.querySelector("#main-menu");
  const navItems = document.querySelectorAll("#main-menu > ul > li > a");
  const sections = [
    ...document.querySelectorAll<HTMLElement>("section[id]"),
  ];
  let lockedSectionId: string | null = null;
  let unlockTimer: number | undefined;

  const setActiveNavItem = (sectionId: string) => {
    navItems.forEach((item) => {
      if (item.getAttribute("href") === `#${sectionId}`) {
        item.classList.add("text-white", "lg:after:opacity-100");
      } else {
        item.classList.remove("text-white", "lg:after:opacity-100");
      }
    });
  };

  const updateActiveNavItem = () => {
    if (lockedSectionId) {
      setActiveNavItem(lockedSectionId);
      return;
    }

    const headerOffset = 140;
    const currentPosition = window.scrollY + headerOffset;
    const currentSection = sections
      .filter((section) => currentPosition >= section.offsetTop)
      .at(-1);

    if (currentSection) {
      setActiveNavItem(currentSection.id);
    }
  };

  const toggleMenu = () => {
    menu?.classList.toggle("hidden");
    const isHidden = menu?.classList.contains("hidden");
    button?.setAttribute("aria-expanded", `${!isHidden}`);
  };

  button?.addEventListener("click", toggleMenu);
  navItems.forEach((item) => {
    item?.addEventListener("click", () => {
      const sectionId = item.getAttribute("href")?.replace("#", "");
      if (sectionId) {
        lockedSectionId = sectionId;
        setActiveNavItem(sectionId);

        window.clearTimeout(unlockTimer);
        unlockTimer = window.setTimeout(() => {
          lockedSectionId = null;
          updateActiveNavItem();
        }, 900);
      }

      if (!menu?.classList.contains("hidden")) {
        toggleMenu();
      }
    });
  });

  window.addEventListener("scroll", updateActiveNavItem, { passive: true });
  window.addEventListener("load", updateActiveNavItem);
  updateActiveNavItem();
</script>

<style>
  header {
    animation-timeline: scroll();
    animation-range: 0 650px;
  }
</style>
