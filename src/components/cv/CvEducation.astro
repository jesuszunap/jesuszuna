---
import type { CvData, CvLanguage, CvRenderMode } from "../../data/cv";

interface Props {
  data: CvData;
  language: CvLanguage;
  mode: CvRenderMode;
}

const { data, language, mode } = Astro.props;
---

<div class:list={[mode === "web" ? "space-y-4" : "print-list"]}>
  {
    data.education.map((item) => (
      <article class={mode === "web" ? "rounded-lg border border-border bg-card-strong p-5 shadow-sm motion-safe:transition motion-safe:duration-300 hover:border-primary/60 hover:bg-card hover:shadow-lg motion-safe:hover:-translate-y-0.5" : "print-item compact"}>
        <div class={mode === "web" ? "flex flex-col gap-2 md:flex-row md:items-start md:justify-between" : "print-item-heading"}>
          <div>
            <h3 class={mode === "web" ? "text-lg font-semibold text-white" : ""}>
              {item.institution}
            </h3>
            <p class={mode === "web" ? "mt-1 text-sm font-medium text-primary" : "print-role"}>
              {item.degree[language]}
            </p>
          </div>
          <p class={mode === "web" ? "text-sm text-neutral" : "print-meta"}>
            {item.period[language]} · {item.location[language]}
          </p>
        </div>
      </article>
    ))
  }
</div>
