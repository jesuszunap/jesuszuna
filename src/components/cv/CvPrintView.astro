---
import type { CvData, CvLanguage } from "../../data/cv";
import CvContactActions from "./CvContactActions.astro";
import CvEducation from "./CvEducation.astro";
import CvExperienceList from "./CvExperienceList.astro";
import CvLanguages from "./CvLanguages.astro";
import CvProjectList from "./CvProjectList.astro";
import CvSkillsGrid from "./CvSkillsGrid.astro";

interface Props {
  data: CvData;
  language: CvLanguage;
}

const { data, language } = Astro.props;
const sections = data.ui.sections[language];
---

<main class="print-page">
  <div class="print-actions">
    <a href="/cv">{data.ui.actions[language].backToCv}</a>
    <button type="button" onclick="window.print()">
      {data.ui.actions[language].printOrSave}
    </button>
  </div>

  <article class="resume">
    <header class="resume-header">
      <div>
        <h1>{data.person.name}</h1>
        <p class="resume-title">{data.person.title[language].pdf}</p>
        <p class="resume-summary">{data.person.summary[language].pdf}</p>
      </div>
      <div class="resume-contact">
        <p>{data.person.location[language]}</p>
        <p>{data.person.status[language]}</p>
        <CvContactActions data={data} language={language} mode="pdf" />
      </div>
    </header>

    <section class="resume-section">
      <h2>{sections.experience}</h2>
      <CvExperienceList data={data} language={language} mode="pdf" />
    </section>

    <section class="resume-section">
      <h2>{sections.projects}</h2>
      <CvProjectList data={data} language={language} mode="pdf" />
    </section>

    <section class="resume-section avoid-break">
      <h2>{sections.skills}</h2>
      <CvSkillsGrid data={data} language={language} mode="pdf" />
    </section>

    <div class="resume-bottom">
      <section class="resume-section avoid-break">
        <h2>{sections.education}</h2>
        <CvEducation data={data} language={language} mode="pdf" />
      </section>

      <section class="resume-section avoid-break">
        <h2>{sections.languages}</h2>
        <CvLanguages data={data} language={language} mode="pdf" />
      </section>
    </div>
  </article>
</main>

<style is:global>
  html,
  body {
    margin: 0;
    min-height: 100%;
    background: #f3f4f6;
    color: #111827;
    font-family:
      Inter,
      Arial,
      sans-serif;
  }

  .print-page {
    padding: 24px;
  }

  .print-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin: 0 auto 18px;
    max-width: 210mm;
  }

  .print-actions a,
  .print-actions button {
    border: 1px solid #cbd5e1;
    border-radius: 999px;
    background: white;
    color: #111827;
    cursor: pointer;
    font: inherit;
    font-size: 13px;
    padding: 9px 14px;
    text-decoration: none;
  }

  .resume {
    box-sizing: border-box;
    width: min(210mm, 100%);
    margin: 0 auto;
    padding: 14mm;
    background: #ffffff;
    box-shadow: 0 18px 50px rgb(15 23 42 / 0.14);
  }

  .resume-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 58mm;
    gap: 12mm;
    border-bottom: 1px solid #d1d5db;
    padding-bottom: 7mm;
  }

  .resume h1 {
    margin: 0;
    color: #111827;
    font-size: 24pt;
    line-height: 1.08;
  }

  .resume-title {
    margin: 4px 0 0;
    color: #374151;
    font-size: 11pt;
    font-weight: 700;
  }

  .resume-summary {
    margin: 10px 0 0;
    max-width: 118mm;
    color: #374151;
    font-size: 9.5pt;
    line-height: 1.45;
  }

  .resume-contact {
    color: #374151;
    font-size: 8.6pt;
    line-height: 1.35;
    text-align: right;
  }

  .resume-contact p {
    margin: 0 0 3px;
  }

  .print-contact {
    list-style: none;
    margin: 7px 0 0;
    padding: 0;
  }

  .print-contact li {
    margin: 0 0 3px;
    overflow-wrap: anywhere;
  }

  .resume-section {
    margin-top: 6.5mm;
  }

  .resume-section h2 {
    margin: 0 0 3.5mm;
    border-bottom: 1px solid #e5e7eb;
    color: #111827;
    font-size: 10.5pt;
    letter-spacing: 0.02em;
    line-height: 1.2;
    padding-bottom: 1.5mm;
    text-transform: uppercase;
  }

  .print-list {
    display: grid;
    gap: 4.5mm;
  }

  .print-item {
    break-inside: avoid;
    page-break-inside: avoid;
  }

  .print-item.compact {
    margin-bottom: 0;
  }

  .print-item-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8mm;
  }

  .print-item h3,
  .print-skill-group h3 {
    margin: 0;
    color: #111827;
    font-size: 10pt;
    line-height: 1.25;
  }

  .print-role {
    margin: 1mm 0 0;
    color: #374151;
    font-size: 9pt;
    font-weight: 700;
    line-height: 1.3;
  }

  .print-meta {
    flex: 0 0 auto;
    margin: 0;
    color: #4b5563;
    font-size: 8.5pt;
    line-height: 1.3;
    text-align: right;
  }

  .print-description {
    margin: 1.8mm 0 0;
    color: #374151;
    font-size: 8.8pt;
    line-height: 1.35;
  }

  .print-bullets {
    margin: 1.8mm 0 0;
    padding-left: 4.5mm;
    color: #374151;
    font-size: 8.6pt;
    line-height: 1.35;
  }

  .print-bullets li {
    margin-bottom: 0.8mm;
  }

  .print-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 2mm;
    margin-top: 2mm;
    color: #374151;
    font-size: 8.2pt;
  }

  .print-tags span:not(:last-child)::after {
    content: ",";
  }

  .print-skills {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3.5mm 8mm;
  }

  .print-skill-group {
    break-inside: avoid;
    page-break-inside: avoid;
  }

  .print-skill-group ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1mm 2mm;
    margin: 1.5mm 0 0;
    padding: 0;
    list-style: none;
    color: #374151;
    font-size: 8.4pt;
    line-height: 1.35;
  }

  .print-skill-group li:not(:last-child)::after {
    content: ",";
  }

  .resume-bottom {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 8mm;
  }

  .print-inline-list {
    display: flex;
    flex-wrap: wrap;
    gap: 2mm 5mm;
    margin: 0;
    padding: 0;
    list-style: none;
    color: #374151;
    font-size: 8.8pt;
  }

  .print-inline-list span:first-child {
    font-weight: 700;
  }

  .avoid-break {
    break-inside: avoid;
    page-break-inside: avoid;
  }

  @page {
    size: A4;
    margin: 11mm;
  }

  @media print {
    html,
    body {
      background: white;
    }

    .print-page {
      padding: 0;
    }

    .print-actions {
      display: none;
    }

    .resume {
      width: auto;
      margin: 0;
      padding: 0;
      box-shadow: none;
    }
  }

  @media (max-width: 760px) {
    .print-page {
      padding: 12px;
    }

    .resume {
      padding: 20px;
    }

    .resume-header,
    .resume-bottom,
    .print-skills {
      grid-template-columns: 1fr;
    }

    .resume-contact,
    .print-meta {
      text-align: left;
    }

    .print-item-heading {
      display: block;
    }
  }
</style>
