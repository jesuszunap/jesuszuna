---
import type { CvData, CvLanguage } from "../../data/cv";

interface Props {
  data: CvData;
  defaultLanguage: CvLanguage;
}

const { data, defaultLanguage } = Astro.props;
---

<div
  class="relative inline-flex w-fit max-w-fit self-start overflow-hidden rounded-full border border-border bg-card p-1 shadow-sm backdrop-blur-md motion-safe:transition motion-safe:duration-200 hover:border-primary/55 hover:shadow-md"
  role="group"
  aria-label="Seleccionar idioma del CV"
  data-cv-language-toggle
>
  <span
    class:list={[
      "pointer-events-none absolute top-1 bottom-1 left-1 w-24 rounded-full bg-primary shadow-sm motion-safe:transition-transform motion-safe:duration-300 motion-safe:ease-out",
      defaultLanguage === "en" ? "translate-x-24" : "translate-x-0",
    ]}
    aria-hidden="true"
    data-cv-lang-indicator
  >
  </span>
  {
    (["es", "en"] as CvLanguage[]).map((language) => (
      <button
        class:list={[
          "relative z-10 w-24 rounded-full px-4 py-2 text-center text-xs font-medium outline-none motion-safe:transition motion-safe:duration-200 focus-visible:ring-2 focus-visible:ring-primary/40",
          language === defaultLanguage
            ? "text-black"
            : "text-neutral hover:text-white",
        ]}
        type="button"
        data-cv-lang-button={language}
        aria-pressed={language === defaultLanguage ? "true" : "false"}
      >
        {data.ui.languageToggle[language].label}
      </button>
    ))
  }
</div>
