---
import type { HeroProps } from "@types";

type Props = HeroProps;

const { id, name, specialty, summary, actions, technologies } = Astro.props;
---

<section class="py-24 md:py-32" id={id}>
  <h1
    class="mb-1.5 font-serif text-7xl font-bold tracking-tightest text-white sm:text-8xl md:mb-0 md:text-9xl"
  >
    {name}
  </h1>
  <p
    class="mb-9 font-serif text-4xl leading-11.5 font-bold tracking-tighter text-primary sm:text-5xl md:text-6xl"
  >
    {specialty}
  </p>
  <p class="mb-10 text-base font-normal text-neutral md:text-lg">
    {summary}
  </p>

  <div class="mb-10 flex flex-wrap gap-4">
    {
      actions.map((action) => (
        <a
          class="inline-block rounded-full bg-primary px-8 py-5 text-sm leading-5 font-medium text-[#fff]"
          href={action.href}
        >
          {action.text}
        </a>
      ))
    }
  </div>

  <ul class="flex flex-wrap gap-3 text-xs text-neutral">
    {technologies.map((technology) => <li>{technology}</li>)}
  </ul>
</section>
