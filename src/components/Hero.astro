---
import type { HeroProps } from "@types";

type Props = HeroProps;

const { id, name, specialty, summary, actions, technologies } = Astro.props;
---

<section
  class="grid gap-12 py-20 md:py-28 lg:grid-cols-[1.1fr_0.9fr]"
  id={id}
>
  <div>
    <p class="mb-5 text-sm font-medium text-primary">
      Software, comunidad y proyectos con enfoque humano
    </p>
    <h1
      class="mb-4 max-w-4xl font-serif text-5xl font-bold text-white sm:text-7xl md:text-8xl"
    >
      {name}
    </h1>
    <p
      class="mb-8 max-w-4xl font-serif text-2xl font-semibold text-primary sm:text-4xl md:text-5xl"
    >
      {specialty}
    </p>
    <p class="mb-10 max-w-3xl text-base font-normal text-neutral md:text-lg">
      {summary}
    </p>

    <div class="mb-10 flex flex-wrap gap-4">
      {
        actions.map((action, index) => (
          <a
            class:list={[
              "inline-block rounded-full border px-7 py-4 text-sm font-medium",
              index === 0
                ? "border-primary bg-primary text-black hover:-translate-y-0.5"
                : "border-border bg-card text-white hover:border-primary hover:text-primary",
            ]}
            href={action.href}
          >
            {action.text}
          </a>
        ))
      }
    </div>

    <ul class="flex max-w-3xl flex-wrap gap-3 text-xs text-neutral">
      {
        technologies.map((technology) => (
          <li class="rounded-full border border-border bg-card px-3 py-1.5 backdrop-blur-sm">
            {technology}
          </li>
        ))
      }
    </ul>
  </div>

  <div
    aria-hidden="true"
    class="relative min-h-72 overflow-hidden rounded-lg border border-border bg-card p-6 shadow-sm backdrop-blur-md md:min-h-80"
  >
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,var(--accent-soft),transparent_18rem)]">
    </div>
    <div class="relative flex h-full flex-col justify-between gap-8">
      <div class="space-y-3">
        <div class="h-2 w-24 rounded-full bg-primary/70"></div>
        <div class="h-2 w-36 rounded-full bg-white/20"></div>
        <div class="h-2 w-28 rounded-full bg-white/15"></div>
      </div>
      <div class="grid gap-3">
        <div class="rounded-lg border border-border bg-card-strong p-4">
          <p class="text-xs text-primary">Automatizar</p>
          <p class="mt-2 text-sm text-white">Procesos repetitivos</p>
        </div>
        <div class="ml-8 rounded-lg border border-border bg-card-strong p-4">
          <p class="text-xs text-primary">Organizar</p>
          <p class="mt-2 text-sm text-white">Información clara y útil</p>
        </div>
        <div class="rounded-lg border border-border bg-card-strong p-4">
          <p class="text-xs text-primary">Conectar</p>
          <p class="mt-2 text-sm text-white">Tecnología y comunidad</p>
        </div>
      </div>
    </div>
  </div>
</section>
