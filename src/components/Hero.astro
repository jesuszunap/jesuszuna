---
import type { HeroProps } from "@types";

type Props = HeroProps;

const { id, name, specialty, summary, actions, technologies } = Astro.props;
---

<section
  class="grid scroll-mt-24 gap-10 pt-12 pb-18 md:scroll-mt-28 md:pt-18 md:pb-24 lg:grid-cols-[1.1fr_0.9fr]"
  id={id}
>
  <div>
    <p class="mb-4 text-sm font-medium text-primary">
      Software, comunidad y proyectos con enfoque humano
    </p>
    <h1
      class="mb-4 max-w-4xl font-serif text-5xl font-bold text-white sm:text-7xl md:text-8xl"
    >
      {name}
    </h1>
    <p
      class="mb-6 max-w-4xl font-serif text-xl font-medium text-primary sm:text-3xl md:text-4xl"
    >
      {specialty}
    </p>
    <p class="mb-8 max-w-3xl text-base font-normal text-neutral md:text-lg">
      {summary}
    </p>

    <div class="mb-8 flex flex-wrap gap-4">
      {
        actions.map((action, index) => (
          <a
            class:list={[
              "group inline-block rounded-full border px-7 py-4 text-sm font-medium outline-none motion-safe:transition motion-safe:duration-200 motion-safe:ease-out hover:shadow-md focus-visible:shadow-md focus-visible:ring-2 focus-visible:ring-primary/40",
              index === 0
                ? "border-primary bg-primary text-black hover:shadow-primary/10"
                : "border-border bg-card text-white hover:border-primary hover:bg-card-strong hover:text-primary",
            ]}
            href={action.href}
          >
            <span class="inline-block motion-safe:transition motion-safe:duration-200 motion-safe:ease-out motion-safe:group-hover:-translate-y-0.5">
              {action.text}
            </span>
          </a>
        ))
      }
    </div>

    <ul class="flex max-w-3xl flex-wrap gap-3 text-xs text-neutral">
      {
        technologies.map((technology) => (
          <li class="rounded-full border border-border bg-card px-3 py-1.5 backdrop-blur-sm motion-safe:transition motion-safe:duration-200 hover:border-primary hover:bg-card-strong motion-safe:hover:-translate-y-0.5">
            {technology}
          </li>
        ))
      }
    </ul>
  </div>

  <div
    aria-hidden="true"
    class="relative min-h-72 overflow-hidden rounded-lg border border-border bg-card p-6 shadow-sm backdrop-blur-md motion-safe:transition motion-safe:duration-300 motion-safe:ease-out hover:border-primary hover:shadow-xl motion-safe:hover:-translate-y-1 md:min-h-80"
  >
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,var(--accent-soft),transparent_18rem)]">
    </div>
    <div class="absolute inset-0 opacity-35 [background-image:radial-gradient(var(--accent-main)_1px,transparent_1px)] [background-size:18px_18px]">
    </div>
    <div class="absolute right-6 top-6 h-14 w-24 rounded-lg border border-border bg-card-strong/70 backdrop-blur-md">
      <div class="mx-3 mt-3 h-1.5 rounded-full bg-primary/55"></div>
      <div class="mx-3 mt-2 h-1.5 w-10 rounded-full bg-white/15"></div>
    </div>
    <div class="absolute bottom-8 left-6 flex gap-2">
      <span class="h-2 w-10 rounded-full bg-primary/45"></span>
      <span class="h-2 w-6 rounded-full bg-white/15"></span>
      <span class="h-2 w-8 rounded-full bg-white/10"></span>
    </div>
    <div class="relative flex h-full flex-col justify-between gap-8">
      <div class="space-y-3">
        <div class="h-2 w-24 rounded-full bg-primary/70"></div>
        <div class="h-2 w-36 rounded-full bg-white/20"></div>
        <div class="h-2 w-28 rounded-full bg-white/15"></div>
      </div>
      <div class="grid gap-3">
        <div class="rounded-lg border border-border bg-card-strong p-4 motion-safe:transition motion-safe:duration-200 hover:border-primary hover:bg-card">
          <p class="text-xs text-primary">Automatizar</p>
          <p class="mt-2 text-sm text-white">Procesos repetitivos</p>
        </div>
        <div class="ml-8 rounded-lg border border-border bg-card-strong p-4 motion-safe:transition motion-safe:duration-200 hover:border-primary hover:bg-card">
          <p class="text-xs text-primary">Organizar</p>
          <p class="mt-2 text-sm text-white">Información clara y útil</p>
        </div>
        <div class="rounded-lg border border-border bg-card-strong p-4 motion-safe:transition motion-safe:duration-200 hover:border-primary hover:bg-card">
          <p class="text-xs text-primary">Conectar</p>
          <p class="mt-2 text-sm text-white">Tecnología y comunidad</p>
        </div>
      </div>
    </div>
  </div>
</section>
