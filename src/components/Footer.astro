---
import type { FooterProps, SiteConfig } from "@types";

type Props = Pick<SiteConfig, "author" | "brand" | "socialLinks"> & {
  footer: FooterProps;
};

const { brand, footer } = Astro.props;
const isHome = Astro.url.pathname === "/";
const getNavHref = (href: string) =>
  href.startsWith("#") && !isHome ? `/${href}` : href;
---

<footer class="w-full border-t border-border px-5 pt-10 pb-8 text-white">
  <div class="mx-auto grid max-w-5xl gap-8 text-sm md:grid-cols-4">
    <div>
      <p class="font-serif text-xl font-bold">{brand}</p>
      <p class="mt-3 text-neutral">{footer.tagline}</p>
    </div>
    <div>
      <p class="mb-3 text-xs font-medium text-primary">Navegación</p>
      <ul class="space-y-2 text-neutral">
        {
          footer.navLinks.map(({ text, href }) => (
            <li>
              <a class="hover:text-primary" href={getNavHref(href)}>
                {text}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="mb-3 text-xs font-medium text-primary">Contacto</p>
      <ul class="space-y-2 text-neutral">
        {
          footer.contactLinks.map(({ text, href }) => (
            <li>
              {href ? (
                <a
                  class="hover:text-primary"
                  href={href}
                  target={href.startsWith("http") ? "_blank" : undefined}
                >
                  {text}
                </a>
              ) : (
                <span>{text}</span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="mb-3 text-xs font-medium text-primary">Legal</p>
      <ul class="space-y-2 text-neutral">
        {
          footer.legalLinks.map(({ text, href }) => (
            <li>
              <a class="hover:text-primary" href={href}>
                {text}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <p class="mx-auto mt-10 max-w-5xl text-xs text-neutral">
    © 2026 {brand}. Todos los derechos reservados.
  </p>
</footer>
