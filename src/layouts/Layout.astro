---
import Navbar from "@components/Navbar.astro";
import { Font } from "astro:assets";
import Analytics from "@vercel/analytics/astro";
import { SITE_CONFIG } from "@config";
import Footer from "@components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: "article" | "profile" | "website";
}

const pageTitle = Astro.props.title;
const pageDescription = Astro.props.description;
const pageOgTitle = Astro.props.ogTitle;
const pageOgDescription = Astro.props.ogDescription;
const pageOgImage = Astro.props.ogImage;
const pageOgType = Astro.props.ogType;

const {
  brand,
  siteUrl,
  title: defaultTitle,
  description: defaultDescription,
  ogTitle: defaultOgTitle,
  ogDescription: defaultOgDescription,
  ogImage,
  navLinks,
  language,
  author,
  socialLinks,
  footer,
} = SITE_CONFIG;

const title = pageTitle ?? defaultTitle;
const description = pageDescription ?? defaultDescription;
const ogTitle = pageOgTitle ?? pageTitle ?? defaultOgTitle;
const ogDescription =
  pageOgDescription ?? pageDescription ?? defaultOgDescription;
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(pageOgImage ?? ogImage, siteUrl).href;
const isHome = Astro.url.pathname === "/";
const sameAs = socialLinks.map(({ href }) => href);
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: brand,
    alternateName: ["Jesus Zuna", "Jesus Zuna Pacheco", "Jesús Zuña Pacheco"],
    url: siteUrl,
    jobTitle:
      "Desarrollador de software y estudiante de Ingeniería en Software",
    email: SITE_CONFIG.email,
    sameAs,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: brand,
    url: siteUrl,
    description,
    inLanguage: language,
    publisher: {
      "@type": "Person",
      name: brand,
    },
  },
  ...(isHome
    ? [
        {
          "@context": "https://schema.org",
          "@type": "ProfilePage",
          name: title,
          url: canonicalURL,
          description,
          inLanguage: language,
          mainEntity: {
            "@type": "Person",
            name: brand,
            url: siteUrl,
            sameAs,
          },
        },
      ]
    : []),
];
---

<!doctype html>
<html lang={language} class="scroll-pt-16 scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (() => {
        const storageKey = "theme";
        const root = document.documentElement;
        const savedTheme = localStorage.getItem(storageKey);
        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)")
          .matches
          ? "dark"
          : "light";
        const theme =
          savedTheme === "light" || savedTheme === "dark"
            ? savedTheme
            : systemTheme;

        root.classList.remove("light", "dark");
        root.classList.add(theme);
        root.style.colorScheme = theme;
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="theme-color"
      content="#f8f5ff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0d1218"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <Font cssVariable="--font-sora" preload />
    <Font cssVariable="--font-inter" preload />

    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageUrl} />
    <meta
      property="og:type"
      content={pageOgType ?? (isHome ? "profile" : "website")}
    />
    <meta property="og:locale" content="es_EC" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={ogTitle} />
    <meta property="twitter:description" content={ogDescription} />
    <meta property="twitter:image" content={ogImageUrl} />
    <Analytics />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body class="min-h-screen font-sans text-white">
    <Navbar brand={brand} navLinks={navLinks} />
    <main class="mx-auto max-w-5xl px-5">
      <slot />
    </main>
    <Footer
      author={author}
      brand={brand}
      socialLinks={socialLinks}
      footer={footer}
    />
  </body>
</html>
