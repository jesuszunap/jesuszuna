---
import Layout from "@layouts/Layout.astro";
import { SITE_CONFIG } from "@config";

interface Props {
  title: string;
  description: string;
  date: Date;
  updatedDate?: Date;
  tags?: string[];
  slug: string;
}

const { title, description, date, updatedDate, tags = [], slug } = Astro.props;
const canonicalUrl = new URL(`/blog/${slug}/`, SITE_CONFIG.siteUrl).href;
const displayDate = new Intl.DateTimeFormat("es-EC", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(date);
const displayUpdatedDate = updatedDate
  ? new Intl.DateTimeFormat("es-EC", {
      day: "numeric",
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    }).format(updatedDate)
  : null;
const blogPosting = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updatedDate ?? date).toISOString(),
  author: {
    "@type": "Person",
    name: SITE_CONFIG.brand,
    url: SITE_CONFIG.siteUrl,
  },
  publisher: {
    "@type": "Person",
    name: SITE_CONFIG.brand,
  },
  mainEntityOfPage: canonicalUrl,
  url: canonicalUrl,
};
---

<Layout
  title={`${title} | ${SITE_CONFIG.brand}`}
  description={description}
  ogTitle={title}
  ogDescription={description}
  ogType="article"
>
  <article class="mx-auto max-w-3xl py-16 md:py-24">
    <a class="mb-10 inline-block text-sm font-medium text-primary" href="/blog">
      Volver al blog
    </a>

    <header class="border-b border-border pb-8">
      <p class="text-xs font-medium text-primary">Blog</p>
      <h1 class="mt-4 font-serif text-4xl font-bold text-white md:text-5xl">
        {title}
      </h1>
      <p class="mt-5 text-lg text-neutral">{description}</p>
      <div class="mt-5 flex flex-wrap items-center gap-3 text-xs text-neutral">
        <time datetime={date.toISOString()}>{displayDate}</time>
        {
          displayUpdatedDate && (
            <span>Actualizado el {displayUpdatedDate}</span>
          )
        }
      </div>
      {
        tags.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2" aria-label="Etiquetas">
            {tags.map((tag) => (
              <li class="rounded-full border border-border bg-card px-3 py-1 text-xs text-neutral">
                {tag}
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div
      class="blog-content mt-10 max-w-[72ch] space-y-6 text-base leading-relaxed text-neutral"
    >
      <slot />
    </div>
  </article>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(blogPosting)}
  />
</Layout>

<style>
  .blog-content :global(h2) {
    margin-top: 2.5rem;
    font-family: var(--font-sora);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 2.2rem;
    color: var(--text-main);
  }

  .blog-content :global(p) {
    margin-top: 1.25rem;
  }

  .blog-content :global(a) {
    color: var(--accent-main);
  }

  .blog-content :global(strong) {
    color: var(--text-main);
  }
</style>
